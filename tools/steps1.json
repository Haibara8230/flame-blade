[
  { "name": "01-newgame", "eval": "document.getElementById('btn-new').click(); 'new'", "wait": 1500 },
  { "name": "02-prologue", "eval": "window.__advance(8) + ' :: ' + JSON.stringify(window.__canvasStats())", "wait": 600 },
  { "name": "03-night", "eval": "window.__advance(40) + ' :: ' + JSON.stringify(window.__canvasStats())", "wait": 900 },
  { "name": "04-battle-start", "eval": "window.__advance(30) + ' :: mode=' + window.__G.mode + ' enemies=' + (window.__G.battle ? window.__G.battle.enemies.length : '-') + ' :: ' + JSON.stringify(window.__canvasStats())", "wait": 2500 },
  { "name": "05-auto1", "eval": "window.__autoBattle()", "wait": 4000 },
  { "name": "06-midbattle", "eval": "JSON.stringify({mode:window.__G.mode, scene:window.__G.sceneId, turn:(window.__G.battle&&window.__G.battle.turn), hp:window.__G.battle&&window.__G.battle.party.map(m=>Math.ceil(m.hp)), ehp:window.__G.battle&&window.__G.battle.enemies.map(e=>e.hp), log:(window.__G.battle&&window.__G.battle.log.map(l=>l.txt.replace(/<[^>]+>/g,'')))}) ", "wait": 500 },
  { "name": "07-auto2", "eval": "window.__autoBattle()", "wait": 6000 },
  { "name": "08-after", "eval": "JSON.stringify({mode:window.__G.mode, scene:window.__G.sceneId, gold:window.__G.gold, lv:window.__G.party.map(m=>m.name+m.level), log:(window.__G.battle?window.__G.battle.log.map(l=>l.txt.replace(/<[^>]+>/g,'')):'-')})", "wait": 800 },
  { "name": "09-stats", "eval": "JSON.stringify(window.__canvasStats())", "wait": 300 }
]
